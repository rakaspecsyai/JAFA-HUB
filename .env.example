DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres"
APP_URL="http://localhost:3000"
MEDIA_DIRECTORY=".local/media"
JAFA_LOCAL_DATABASE="true"
# Development-only presentation of the supplied prototype. Never enabled in production.
JAFA_CONTENT_PREVIEW="false"
# Leave empty unless the reverse proxy overwrites this header and cannot be bypassed.
TRUSTED_IP_HEADER=""
# Generate a unique random value for production; npm run dev creates one locally.
AUTH_RATE_LIMIT_KEY=""
BETTER_AUTH_SECRET=""
# Key dan anggaran wajib untuk embedding berbayar; kosong: hanya potongan/pencarian kata kunci.
OPENAI_API_KEY=""
# Isi batas USD per bulan serta tarif USD per 1 juta token (maksimum 6 desimal).
# Tarif input harus mencakup tarif tertinggi yang mungkin ditagih, termasuk cache-write.
JAFA_AI_MONTHLY_USD=""
JAFA_AI_EMBEDDING_USD_PER_MILLION=""
JAFA_AI_INPUT_USD_PER_MILLION=""
JAFA_AI_OUTPUT_USD_PER_MILLION=""
# Aktifkan hanya setelah model, korpus, evaluasi dan kebijakan privasi disetujui.
OPENAI_RAG_MODEL=""
JAFA_RAG_ENABLED="false"
