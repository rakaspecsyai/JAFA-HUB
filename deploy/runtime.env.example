# Salin ke berkas privat di luar artefak/konteks build. Jangan isi atau commit contoh ini.
APP_URL=
# Buat empat nilai acak berbeda dari 32 byte; gunakan format hex agar password aman dalam URL.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
AUTH_RATE_LIMIT_KEY=
BETTER_AUTH_SECRET=
# Port loopback; reverse proxy HTTPS harus disiapkan sebelum penggunaan CMS nyata.
JAFA_RUNTIME_PORT=53174
# Tetap kosong sampai proxy menimpa header dan akses langsung aplikasi dibatasi.
TRUSTED_IP_HEADER=
