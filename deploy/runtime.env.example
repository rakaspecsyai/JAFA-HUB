# Salin ke berkas privat di luar artefak/konteks build. Jangan isi atau commit contoh ini.
APP_URL=
# Buat empat nilai acak berbeda dari 32 byte; gunakan format hex agar password aman dalam URL.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
AUTH_RATE_LIMIT_KEY=
BETTER_AUTH_SECRET=
# Port loopback; reverse proxy HTTPS harus disiapkan sebelum penggunaan CMS nyata.
JAFA_RUNTIME_PORT=53174
# Tetap kosong sampai proxy menimpa header dan akses langsung aplikasi dibatasi.
TRUSTED_IP_HEADER=
# Key privat; embedding juga memerlukan batas bulanan dan tarif embedding.
OPENAI_API_KEY=
# USD; tarif per 1 juta token, maksimum 6 desimal. Tarif input mencakup cache-write tertinggi.
JAFA_AI_MONTHLY_USD=
JAFA_AI_EMBEDDING_USD_PER_MILLION=
JAFA_AI_INPUT_USD_PER_MILLION=
JAFA_AI_OUTPUT_USD_PER_MILLION=
# Model Responses API/Structured Outputs dipilih pemilik akun; beta tetap mati sebelum evaluasi/privasi disetujui.
OPENAI_RAG_MODEL=
JAFA_RAG_ENABLED=false
